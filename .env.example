# Roavo environment example — copy to `.env` and adjust values.
# Never commit real secrets.

# Application
NODE_ENV=development
APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Supabase PostgreSQL (primary database for local + production)
# Dashboard → Project Settings → Database → Connection string
#
# DATABASE_URL  = Transaction pooler (port 6543) — app runtime / Vercel
# DIRECT_URL    = Direct connection (port 5432) — Prisma migrations
#
# Replace [PASSWORD] and project ref/host from your Supabase project.
# If the password contains special characters, URL-encode them.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&schema=public
DIRECT_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?schema=public

# AI provider selection
# AI provider selection
AI_PROVIDER=gemini
AI_MODEL=gemini-2.0-flash
# Comma-separated Gemini models tried after primary rate-limit / overload
# AI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.0-flash
# Free OpenRouter fallback (Nemotron etc.) — https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-v1-...
# AI_OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free
# Or use OpenRouter as primary:
# AI_PROVIDER=openrouter
# AI_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# GEMINI_API_KEY=...
# AI_API_KEY=...
AI_TIMEOUT_MS=300000
AI_MAX_RETRIES=2
AI_MAX_OUTPUT_TOKENS=8192
AI_TEMPERATURE=0.4
AI_ENABLE_REPAIR=true
AI_DAILY_OPERATION_LIMIT=40
AI_STORE_DEBUG_PAYLOADS=false
# Set false to disable alternate-model fallback on 429/503
# AI_FALLBACK_ON_RATE_LIMIT=false

# Destination discovery — internal catalog only in this release
DESTINATION_PROVIDER=internal

# Ignav flight search (open-jaw / multi-city)
# IGNAV_API_KEY=...

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_TRUST_HOST=true
